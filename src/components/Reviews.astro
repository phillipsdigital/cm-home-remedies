---
import type { Review } from '../data/reviews';
interface Props {
  items: Review[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z';
---

<ul class:list={['reviews', { 'reviews--dark': dark }]}>
  {
    items.map((r) => (
      <li class="review">
        <figure>
          <span class="review__stars" aria-label="5 out of 5 stars">
            {[1, 2, 3, 4, 5].map(() => (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={star} />
              </svg>
            ))}
          </span>
          <blockquote>
            <p>{r.text}</p>
          </blockquote>
          <figcaption>
            <span class="review__name">{r.name}</span>
            <span class="review__meta">
              {r.project ? `${r.project} · ` : ''}via {r.source}
            </span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 320px;
    column-gap: 20px;
  }
  .review {
    break-inside: avoid;
    margin-bottom: 20px;
  }
  figure {
    margin: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-top: 4px solid var(--red);
    padding: 26px 26px 24px;
    display: grid;
    gap: 14px;
  }
  .reviews--dark figure {
    background: var(--ink-2);
    border-color: var(--line-dark);
    border-top-color: var(--red-bright);
  }
  .review__stars {
    display: flex;
    gap: 2px;
    color: var(--red);
  }
  .reviews--dark .review__stars {
    color: var(--red-bright);
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text);
  }
  .reviews--dark blockquote p {
    color: var(--text-on-dark);
  }
  figcaption {
    display: grid;
    gap: 2px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .reviews--dark figcaption {
    border-top-color: var(--line-dark);
  }
  .review__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .review__meta {
    font-size: 14px;
    color: var(--text-muted);
  }
  .reviews--dark .review__meta {
    color: var(--text-on-dark-muted);
  }
</style>
