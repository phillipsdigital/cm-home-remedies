---
import { Image } from 'astro:assets';
import { services, type Service } from '../data/services';
import { byId } from '../data/projects';

interface Props {
  items?: Service[];
  headingLevel?: 'h2' | 'h3';
}
const { items = services, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<ul class="cards">
  {
    items.map((s) => {
      const p = byId(s.heroId);
      return (
        <li class="card">
          <a href={`/services/${s.slug}/`} class="card__link">
            <div class="card__media">
              <Image src={p.image} alt={p.alt} widths={[400, 640, 900]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 420px" style={`object-position:${p.focus ?? '50% 50%'}`} />
            </div>
            <div class="card__body">
              <H class="card__title">{s.name}</H>
              <p>{s.cardBlurb}</p>
              <span class="card__more">
                Learn more
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </div>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 24px;
  }
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s;
  }
  .card__link:hover {
    color: var(--text);
    border-color: var(--red);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px rgba(15, 16, 18, 0.12);
  }
  .card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--ink-3);
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 24px 26px;
    border-top: 3px solid var(--red);
    flex: 1;
  }
  .card__title {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .card__body p {
    color: var(--text-muted);
    font-size: 17px;
  }
  .card__more {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }
</style>
