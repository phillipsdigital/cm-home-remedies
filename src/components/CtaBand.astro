---
import { Image } from 'astro:assets';
import { site } from '../data/site';
// Decorative stock photo (not a CM project) — alt="" on purpose.
import bg from '../assets/backgrounds/bg-pergola-evening.jpg';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Ready to start your project?',
  text = 'Tell us what you have in mind. We will come out, look at the site, and give you a straight answer and a written estimate.',
} = Astro.props;
---

<section class="cta">
  <Image src={bg} alt="" class="cta__bg" layout="full-width" widths={[800, 1400, 2000]} aria-hidden="true" />
  <div class="wrap cta__inner">
    <div class="cta__copy">
      <h2 set:html={title} />
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href="/contact/">Get a Free Estimate</a>
      <a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--red);
    color: #fff;
  }
  .cta__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    max-width: none;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(178, 44, 35, 0.95) 0%, rgba(178, 44, 35, 0.86) 55%, rgba(178, 44, 35, 0.7) 100%);
  }
  .cta__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding-block: clamp(48px, 7vw, 80px);
  }
  .cta__copy {
    display: grid;
    gap: 12px;
    max-width: 640px;
  }
  h2 {
    font-size: clamp(30px, 4vw, 44px);
  }
  p {
    font-size: 19px;
    color: #ffe9e7;
  }
  .btn--light {
    background: #fff;
    color: var(--ink);
  }
  .btn--light:hover {
    background: var(--ink);
    color: #fff;
  }
  .btn--line {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }
  .btn--line:hover {
    border-color: #fff;
    background: rgba(0, 0, 0, 0.12);
    color: #fff;
  }
</style>
