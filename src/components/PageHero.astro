---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  crumbs: { name: string; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
  focus?: string;
}
const { eyebrow, title, lede, crumbs, image, imageAlt = '', focus = '50% 50%' } = Astro.props;
---

<section class:list={['page-hero on-dark', { 'page-hero--image': image }]}>
  {
    image && (
      <Image
        src={image}
        alt={imageAlt}
        class="page-hero__img"
        layout="full-width"
        widths={[640, 960, 1280, 1600, 2000]}
        loading="eager"
        fetchpriority="high"
        style={`object-position:${focus}`}
      />
    )
  }
  <div class="wrap page-hero__inner">
    <Breadcrumbs items={crumbs} />
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {lede && <p class="page-hero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--ink);
    color: #fff;
    overflow: hidden;
  }
  .page-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
  }
  .page-hero--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 16, 18, 0.92) 0%, rgba(15, 16, 18, 0.72) 42%, rgba(15, 16, 18, 0.18) 100%);
  }
  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding-block: clamp(56px, 8vw, 104px);
  }
  .page-hero--image .page-hero__inner {
    padding-block: clamp(72px, 11vw, 144px);
  }
  h1 {
    font-size: clamp(40px, 6vw, 68px);
    max-width: 16ch;
  }
  .page-hero__lede {
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: #d3d5d7;
    max-width: 600px;
  }
  @media (max-width: 720px) {
    .page-hero--image::after {
      background: rgba(15, 16, 18, 0.82);
    }
  }
</style>
