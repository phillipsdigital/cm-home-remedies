---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
// Decorative stock photo (not a CM project)
import bg from '../assets/backgrounds/bg-fire-pit-patio.jpg';
import { site } from '../data/site';
---

<BaseLayout title="Thank You | CM Home Remedies" description="Thanks for reaching out to CM Home Remedies." noindex>
  <section class="section section--dark simple">
    <Image src={bg} alt="" class="simple__bg" layout="full-width" widths={[800, 1400, 2000]} style="object-position:50% 55%" />
    <div class="wrap simple__inner">
      <span class="eyebrow">Request received</span>
      <h1>Thanks — we’ll be in touch <span class="accent">soon</span></h1>
      <p>We got your message and will get back to you as soon as we can. If it is urgent, call or text <a href={site.phoneHref}>{site.phone}</a>.</p>
      <div class="btn-row">
        <a class="btn btn--red" href="/our-work/">Browse Our Work</a>
        <a class="btn btn--ghost" href="/">Back to Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .simple {
    position: relative;
    overflow: hidden;
  }
  .simple__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-width: none;
  }
  .simple::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 16, 18, 0.93) 0%, rgba(15, 16, 18, 0.8) 50%, rgba(15, 16, 18, 0.55) 100%);
  }
  .simple__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
    padding-block: clamp(48px, 10vw, 120px);
    max-width: 820px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 64px);
  }
  p {
    font-size: 20px;
    color: var(--text-on-dark-muted);
  }
</style>
