---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, serviceAreas } from '../data/site';
import { services } from '../data/services';
import { breadcrumbSchema } from '../lib/schema';
// Decorative stock photo (not a CM project) — no alt text on purpose.
import heroBg from '../assets/backgrounds/bg-fire-pit-patio.jpg';

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const hasEmail = site.email && !site.email.startsWith('[');
const towns = serviceAreas.flatMap((a) => a.towns.map((t) => `${t}, ${a.abbr}`));
const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact CM Home Remedies',
  url: new URL('/contact/', Astro.site).toString(),
  about: { '@id': new URL('/#business', Astro.site).toString() },
};
---

<BaseLayout
  title="Contact & Free Estimates | CM Home Remedies, Joplin MO"
  description="Request a free estimate for masonry, hardscaping, retaining walls, chimney or foundation repair in Joplin and the Four State Area. Call or text (417) 438-4330."
  schema={[breadcrumbSchema(crumbs), contactPage]}
>
  <PageHero
    eyebrow="Free estimates"
    title="Let’s Talk About <span class='accent'>Your Project</span>"
    lede="Call, text or send the form below. Photos of the area help us get you an accurate estimate faster."
    crumbs={crumbs}
    image={heroBg}
    focus="50% 55%"
  />

  <section class="section section--stone">
    <div class="wrap contact">
      <aside class="contact__info">
        <div class="info-card">
          <h2>Call or text</h2>
          <a class="info-card__phone" href={site.phoneHref}>{site.phone}</a>
          <p>The fastest way to reach us. If we are on a job, leave a message and we will call you back.</p>
        </div>
        {
          hasEmail && (
            <div class="info-card">
              <h2>Email</h2>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          )
        }
        <div class="info-card">
          <h2>Service area</h2>
          <p>Based in {site.city}, {site.regionName}. Serving the Four State Area of Missouri, Kansas, Oklahoma and Arkansas.</p>
          <a href="/about/#service-areas">See all towns we serve →</a>
        </div>
        {
          site.hours.length > 0 && (
            <div class="info-card">
              <h2>Hours</h2>
              <ul>
                {site.hours.map((h) => (
                  <li>
                    <span>{h.days}</span> {h.label}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>

      <div class="form-card">
        <h2>Request a free estimate</h2>
        <p class="form-card__sub">Fields marked * are required.</p>
        <form class="form" method="POST" action={site.formEndpoint}>
          <input type="hidden" name="_subject" value="New Estimate Request - CM Home Remedies" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="true" />
          <input type="hidden" name="_next" value={new URL('/thank-you/', Astro.site).toString()} />
          <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <fieldset class="group">
            <legend>Your contact info</legend>
            <div class="form__row">
              <div class="field">
                <label for="name">Full name *</label>
                <input id="name" name="Name" type="text" autocomplete="name" required />
              </div>
              <div class="field">
                <label for="phone">Phone *</label>
                <input id="phone" name="Phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9()+.\- ]{10,}" title="Enter a 10-digit phone number" />
              </div>
            </div>
            <div class="form__row">
              <div class="field">
                <label for="email">Email *</label>
                <input id="email" name="Email" type="email" autocomplete="email" required />
              </div>
              <div class="field">
                <label for="town">Project town *</label>
                <input id="town" name="Project Town" type="text" list="town-list" autocomplete="address-level2" placeholder="e.g. Joplin, MO" required />
                <datalist id="town-list">
                  {towns.map((t) => <option value={t} />)}
                </datalist>
              </div>
            </div>
            <div class="field">
              <span class="label" id="owner-label">Do you own the property? *</span>
              <div class="choices" role="radiogroup" aria-labelledby="owner-label">
                <label class="choice"><input type="radio" name="Property Owner" value="Yes, I own it" required /> Yes, I own it</label>
                <label class="choice"><input type="radio" name="Property Owner" value="Builder / contractor" /> Builder or contractor</label>
                <label class="choice"><input type="radio" name="Property Owner" value="No — renting / need owner approval" /> No, I rent</label>
              </div>
            </div>
          </fieldset>

          <fieldset class="group">
            <legend>About the project</legend>
            <div class="field">
              <label for="service">Type of project *</label>
              <select id="service" name="Project Type" required>
                <option value="">Select a service</option>
                {services.map((s) => <option>{s.name}</option>)}
                <option>Something else</option>
              </select>
            </div>
            <div class="form__row">
              <div class="field">
                <label for="budget">Budget for the project *</label>
                <select id="budget" name="Budget" required>
                  <option value="">Select a range</option>
                  <option>Under $1,000</option>
                  <option>$1,000 – $5,000</option>
                  <option>$5,000 – $15,000</option>
                  <option>$15,000 – $30,000</option>
                  <option>$30,000+</option>
                </select>
              </div>
              <div class="field">
                <label for="timeline">When do you want to start? *</label>
                <select id="timeline" name="Timeline" required>
                  <option value="">Select a timeframe</option>
                  <option>As soon as possible</option>
                  <option>Within 1–3 months</option>
                  <option>3–6 months</option>
                  <option>6+ months</option>
                  <option>Just gathering prices</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="message">Description of the project *</label>
              <textarea id="message" name="Project Description" rows="6" required minlength="40" aria-describedby="message-hint" placeholder="What needs to be built or repaired? Include rough size (e.g. 40 ft wall, 3 ft tall), materials you like, and any problems you've noticed."></textarea>
              <p class="hint" id="message-hint">At least a few sentences. The more detail, the more accurate the estimate.</p>
            </div>
            <div class="field">
              <label for="source">How did you hear about us?</label>
              <select id="source" name="Heard About Us">
                <option value="">Select one (optional)</option>
                <option>Google</option>
                <option>Facebook</option>
                <option>Friend or neighbor</option>
                <option>Saw a job site or yard sign</option>
                <option>Other</option>
              </select>
            </div>
          </fieldset>
          <button class="btn btn--red form__submit" type="submit">
            Request My Estimate
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
          <p class="form__status" role="status" aria-live="polite" data-form-status></p>
          <p class="form__fine">Have photos? Text them to <a href={site.phoneHref}>{site.phone}</a> after you submit. They help us give you a faster, more accurate estimate.</p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 16px;
  }
  .info-card {
    background: var(--paper);
    border-left: 4px solid var(--red);
    padding: 24px 26px;
    display: grid;
    gap: 8px;
  }
  .info-card h2 {
    font-size: 15px;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--text-muted);
  }
  .info-card__phone {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    color: var(--text);
    text-decoration: none;
    line-height: 1.1;
  }
  .info-card__phone:hover {
    color: var(--red);
  }
  .info-card p {
    color: var(--text-muted);
    font-size: 17px;
  }
  .info-card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .form-card {
    background: var(--paper);
    padding: clamp(28px, 4vw, 48px);
    border-top: 6px solid var(--ink);
  }
  .form-card h2 {
    font-size: clamp(28px, 3vw, 36px);
  }
  .form-card__sub {
    color: var(--text-muted);
    font-size: 15px;
    margin: 8px 0 28px;
  }
  .form {
    display: grid;
    gap: 20px;
  }
  .form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .field {
    display: grid;
    gap: 8px;
  }
  label {
    font-weight: 600;
    font-size: 16px;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 17px;
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: 1.5px solid #c9c7c2;
    border-radius: var(--radius);
    background: #fff;
    color: var(--text);
  }
  textarea {
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgba(214, 58, 47, 0.25);
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .group {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
    min-width: 0;
  }
  legend {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red);
    padding: 0;
    margin-bottom: 4px;
    float: left;
    width: 100%;
  }
  legend + * {
    clear: both;
  }
  .group + .group {
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .label {
    font-weight: 600;
    font-size: 16px;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .choice {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 10px 16px;
    border: 1.5px solid #c9c7c2;
    border-radius: var(--radius);
    font-weight: 500;
    cursor: pointer;
  }
  .choice:has(input:checked) {
    border-color: var(--ink);
    background: var(--stone);
  }
  .choice input {
    width: 18px;
    height: 18px;
    min-height: 0;
    margin: 0;
    accent-color: var(--red);
    flex: none;
  }
  .hint {
    font-size: 14px;
    color: var(--text-muted);
  }
  .form__submit {
    justify-self: start;
    min-width: 220px;
  }
  .form__status {
    font-weight: 600;
  }
  .form__status:empty {
    display: none;
  }
  .form__fine {
    font-size: 15px;
    color: var(--text-muted);
  }
  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
    .form-card {
      order: -1;
    }
  }
  @media (max-width: 560px) {
    .form__row {
      grid-template-columns: minmax(0, 1fr);
    }
      .form__submit {
      justify-self: stretch;
    }
  }
</style>
